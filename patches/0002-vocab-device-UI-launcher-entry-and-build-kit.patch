++    if (fseek(g_bank.file, (long)(g_bank.index_off + id * VOCAB_INDEX_ENTRY), SEEK_SET) != 0)
++        return false;
++    unsigned char raw[VOCAB_INDEX_ENTRY];
++    if (fread(raw, 1, sizeof(raw), g_bank.file) != sizeof(raw)) return false;
