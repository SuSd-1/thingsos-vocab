++static bool read_string(uint32_t offset, char *buf, size_t bytes) {
++    if (!buf || bytes == 0) return false;
++    buf[0] = 0;
++    if (!g_bank.file) return false;
++    if (fseek(g_bank.file, (long)(g_bank.strings_off + offset), SEEK_SET) != 0) return false;
++    size_t used = 0;
