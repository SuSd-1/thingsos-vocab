++    if stale:
++        print(f"  {len(stale)} vendor files differ from the stale pin list (archive repack), e.g. {stale[0]}")
++    if bad:
++        for name, why in bad:
++            print(f"  MISMATCH {name} ({why})")
++        return 1
++    return 0
++
++if __name__ == "__main__":
