++++bool vocab_config_load(const char *root, vocab_config_t *cfg) {
++++    vocab_config_defaults(cfg);
++++    char path[256];
++++    snprintf(path, sizeof(path), "%s/.thingsos/vocab/config.bin", root);
++++    FILE *f = fopen(path, "rb");
