+++    if (!g_queue || g_queue_len >= g_count) return false;
+++    uint32_t at = g_queue_pos + 3;
+++    if (at > g_queue_len) at = g_queue_len;
+++    memmove(g_queue + at + 1, g_queue + at, (g_queue_len - at) * sizeof(uint32_t));
+++    g_queue[at] = id;
+++    g_queue_len++;
+++    return true;
+++}
+++
+++/* ------------------------------------------------------------------- API */
+++
+++bool vocab_open(const char *root, uint32_t now_min) {
+++    if (!root || !*root) return false;
+++    vocab_close(now_min);
+++    snprintf(g_root, sizeof(g_root), "%s", root);
+++    g_now = now_min;
+++    if (!ensure_dirs()) return false;
+++    if (!bank_open()) {
+++        bank_close();
+++        return false;
+++    }
+++    g_bank_hash = g_bank.bank_hash;
+++    if (!state_load()) {
+++        bank_close();
+++        free(g_records);
+++        g_records = NULL;
+++        return false;
+++    }
+++    journal_replay();
+++    g_queue = calloc(g_count ? g_count : 1, sizeof(uint32_t));
+++    vocab_config_load(g_root, &g_config);
+++    g_open = true;
+++    g_current_valid = false;
+++    return g_queue != NULL;
+++}
+++
+++void vocab_close(uint32_t now_min) {
+++    if (g_open) {
+++        g_now = now_min ? now_min : g_now;
+++        state_save();
+++    }
+++    bank_close();
+++    free(g_records);
+++    free(g_queue);
+++    g_records = NULL;
+++    g_queue = NULL;
+++    g_count = 0;
+++    g_queue_len = g_queue_pos = 0;
+++    g_undo_count = 0;
+++    g_open = false;
+++}
+++
+++bool vocab_opened(void) { return g_open; }
+++uint32_t vocab_count(void) { return g_count; }
+++
+++bool vocab_begin_day(uint32_t now_min, const vocab_config_t *cfg) {
+++    if (!g_open) return false;
+++    if (cfg) g_config = *cfg;
+++    g_now = now_min;
+++    const uint32_t day = now_min / VOCAB_MINUTE_PER_DAY;
+++    if (day != g_last_day) {
+++        g_streak = (g_last_day && day == g_last_day + 1) ? (uint16_t)(g_streak + 1) : 1;
+++        g_last_day = day;
+++        g_new_today = 0;
+++        g_reviews_today = 0;
+++    }
+++    queue_build(now_min, &g_config);
+++    return true;
+++}
+++
+++bool vocab_next(vocab_card_t *out, vocab_card_stage_t *stage) {
+++    if (!g_open || !out || !g_queue) return false;
+++    while (g_queue_pos < g_queue_len) {
+++        uint32_t id = g_queue[g_queue_pos];
+++        if (id >= g_count) {
+++            g_queue_pos++;
+++            continue;
+++        }
+++        vocab_state_record_t *record = &g_records[id];
+++        if (record->state != VOCAB_STATE_NEW && record->due_min && record->due_min > g_now) {
+++            g_queue_pos++;
+++            continue;
+++        }
+++        g_current = id;
+++        g_current_valid = true;
+++        g_revealed = false;
+++
+++        vocab_index_t index;
+++        if (!read_index(id, &index)) {
+++            g_queue_pos++;
+++            continue;
+++        }
+++        memset(out, 0, sizeof(*out));
+++        out->id = id;
+++        read_string(index.word_off, out->word, sizeof(out->word));
+++        read_string(index.phonetic_off, out->phonetic, sizeof(out->phonetic));
+++        read_string(index.meaning_off, out->meaning, sizeof(out->meaning));
+++        read_string(index.example_en_off, out->example_en, sizeof(out->example_en));
+++        read_string(index.example_zh_off, out->example_zh, sizeof(out->example_zh));
+++        read_string(index.root_off, out->root, sizeof(out->root));
+++        read_string(index.group_off, out->group, sizeof(out->group));
+++
+++        if (record->state == VOCAB_STATE_NEW) {
+++            g_stage = VOCAB_STAGE_WORD;
+++        } else if (record->state == VOCAB_STATE_REVIEW && (record->reps % 3u) == 1u) {
+++            g_stage = VOCAB_STAGE_AUDIO;
+++        } else {
+++            g_stage = VOCAB_STAGE_RECALL;
+++        }
+++        if (stage) *stage = g_stage;
+++        return true;
+++    }
+++    g_current_valid = false;
+++    return false;
+++}
+++
+++bool vocab_answer(uint32_t now_min, vocab_grade_t grade) {
+++    if (!g_open || !g_current_valid) return false;
+++    if (grade < VOCAB_AGAIN || grade > VOCAB_EASY) return false;
+++    g_now = now_min;
+++    vocab_state_record_t *record = &g_records[g_current];
+++    const bool was_new = record->state == VOCAB_STATE_NEW;
+++
+++    vocab_undo_t *undo = &g_undo[g_undo_count % VOCAB_UNDO_DEPTH];
+++    undo->id = g_current;
+++    undo->record = *record;
+++    undo->queue_pos = g_queue_pos;
+++    undo->new_today = g_new_today;
+++    undo->reviews_today = g_reviews_today;
+++    g_undo_count++;
+++
+++    schedule_record(record, grade, now_min, &g_config);
+++    journal_append(g_current, record);
+++    log_review(g_current, (int)grade, now_min, record);
+++    g_queue_pos++;
+++    if (was_new && g_new_today < 0xFFFF) g_new_today++;
+++    if (g_reviews_today < 0xFFFF) g_reviews_today++;
+++
+++    if (record->state == VOCAB_STATE_LEARNING || record->state == VOCAB_STATE_RELEARNING)
+++        queue_reinsert(g_current);
+++    g_current_valid = false;
+++    return true;
+++}
+++
+++bool vocab_undo(uint32_t now_min) {
+++    if (!g_open || g_undo_count == 0) return false;
+++    g_undo_count--;
+++    vocab_undo_t *undo = &g_undo[g_undo_count % VOCAB_UNDO_DEPTH];
+++    if (undo->id >= g_count) return false;
+++    g_records[undo->id] = undo->record;
+++    g_queue_pos = undo->queue_pos;
+++    g_new_today = undo->new_today;
+++    g_reviews_today = undo->reviews_today;
+++    g_current = undo->id;
+++    g_current_valid = true;
+++    g_now = now_min ? now_min : g_now;
+++    /* Tombstone the last journal entry so a crash cannot replay the undone step. */
+++    char path[256];
+++    journal_path(path, sizeof(path));
+++    FILE *f = fopen(path, "rb+");
+++    if (f) {
+++        if (fseek(f, -(long)VOCAB_JOURNAL_ENTRY, SEEK_END) == 0) {
+++            unsigned char zero[VOCAB_JOURNAL_ENTRY] = {0};
+++            fwrite(zero, 1, sizeof(zero), f);
+++            fflush(f);
+++        }
+++        fclose(f);
+++    }
+++    return true;
+++}
+++
+++bool vocab_stats(uint32_t now_min, vocab_stats_t *out) {
+++    if (!g_open || !out) return false;
+++    memset(out, 0, sizeof(*out));
+++    g_now = now_min ? now_min : g_now;
+++    out->new_today = g_new_today;
+++    out->reviews_today = g_reviews_today;
+++    out->streak = g_streak;
+++    for (uint32_t i = 0; i < g_count; i++) {
+++        const vocab_state_record_t *record = &g_records[i];
+++        if (record->state != VOCAB_STATE_NEW) {
+++            out->learned++;
+++            if (record->due_min && record->due_min <= g_now) out->due_today++;
+++        }
+++        out->total++;
+++    }
+++    out->finished = g_queue_pos >= g_queue_len;
+++    return true;
+++}
+++
+++bool vocab_audio_path(uint32_t id, char *buf, size_t bytes) {
+++    if (!buf || bytes == 0) return false;
+++    snprintf(buf, bytes, "%s/.thingsos/vocab/audio/%u.mp3", g_root, (unsigned)id);
+++    return access(buf, R_OK) == 0;
+++}
+++
+++uint32_t vocab_current_id(void) { return g_current_valid ? g_current : 0xFFFFFFFFu; }
+++vocab_card_stage_t vocab_current_stage(void) { return g_stage; }
+++bool vocab_current_revealed(void) { return g_revealed; }
+++void vocab_reveal(void) { g_revealed = true; }
+++
+++bool vocab_export_log(const char *path) {
+++    if (!path || !*path) return false;
+++    char source[256];
+++    path_of(source, sizeof(source), "review-log.csv");
+++    FILE *in = fopen(source, "rb");
+++    if (!in) return false;
+++    FILE *out = fopen(path, "wb");
+++    if (!out) {
+++        fclose(in);
+++        return false;
+++    }
+++    char buffer[512];
+++    size_t got;
+++    bool ok = true;
+++    while ((got = fread(buffer, 1, sizeof(buffer), in)) > 0) {
+++        if (fwrite(buffer, 1, got, out) != got) {
+++            ok = false;
+++            break;
+++        }
+++    }
+++    fclose(in);
+++    fclose(out);
+++    return ok;
+++}
++diff --git a/native/src/vocab_fsrs.c b/native/src/vocab_fsrs.c
++new file mode 100644
++index 0000000..7479f90
++--- /dev/null
+++++ b/native/src/vocab_fsrs.c
++@@ -0,0 +1,103 @@
+++// SPDX-License-Identifier: Apache-2.0
+++#include "thingsos/vocab_fsrs.h"
+++
+++#include <math.h>
+++
+++#define FSRS_MIN_STABILITY 0.01f
+++#define FSRS_MAX_STABILITY 36500.0f
+++#define FSRS_MIN_DIFFICULTY 1.0f
+++#define FSRS_MAX_DIFFICULTY 10.0f
+++
+++/* Official FSRS-6 default parameters (open-spaced-repetition). */
+++static const float FSRS_W[21] = {
+++    0.212f, 1.2931f, 2.3065f, 8.2956f, 6.4133f, 0.8334f, 3.0194f,
+++    0.001f, 1.8722f, 0.1666f, 0.796f, 1.4835f, 0.0614f, 0.2629f,
+++    1.6483f, 0.6014f, 1.8729f, 0.5425f, 0.0912f, 0.0658f, 0.1542f,
+++};
+++
+++static float clampf(float value, float low, float high) {
+++    return value < low ? low : (value > high ? high : value);
+++}
+++
+++/* F chosen so that R(S, S) = 0.9 for the trainable decay w20. */
+++static float decay_factor(void) {
+++    return powf(0.9f, -1.0f / FSRS_W[20]) - 1.0f;
+++}
+++
+++static float difficulty_anchor_easy(void) {
+++    return FSRS_W[4] - expf(FSRS_W[5] * 3.0f) + 1.0f;
+++}
+++
+++float vocab_fsrs_retrievability(float stability, float elapsed_days) {
+++    if (!(stability > 0.0f)) return 0.0f;
+++    if (elapsed_days <= 0.0f) return 1.0f;
+++    const float factor = decay_factor();
+++    return powf(1.0f + factor * elapsed_days / stability, -FSRS_W[20]);
+++}
+++
+++float vocab_fsrs_interval(float stability, float target_retention) {
+++    if (!(stability > 0.0f)) return 1.0f;
+++    float retention = clampf(target_retention, 0.80f, 0.95f);
+++    const float factor = decay_factor();
+++    float days = stability / factor *
+++                 (powf(retention, -1.0f / FSRS_W[20]) - 1.0f);
+++    if (!(days >= 1.0f)) days = 1.0f;
+++    return roundf(days);
+++}
+++
+++void vocab_fsrs_initial(int grade, vocab_fsrs_memory_t *memory) {
+++    int index = grade - 1;
+++    if (index < 0) index = 0;
+++    if (index > 3) index = 3;
+++    float stability = FSRS_W[index];
+++    float difficulty = FSRS_W[4] - expf(FSRS_W[5] * (float)index) + 1.0f;
+++    memory->stability = clampf(stability, FSRS_MIN_STABILITY, FSRS_MAX_STABILITY);
+++    memory->difficulty = clampf(difficulty, FSRS_MIN_DIFFICULTY, FSRS_MAX_DIFFICULTY);
+++}
+++
+++void vocab_fsrs_review(
+++    vocab_fsrs_memory_t *memory, float elapsed_days, int grade, int same_day) {
+++    if (!memory) return;
+++    if (!(memory->stability > 0.0f)) {
+++        vocab_fsrs_initial(grade, memory);
+++        return;
+++    }
+++    if (grade < 1) grade = 1;
+++    if (grade > 4) grade = 4;
+++
+++    const float stability = memory->stability;
+++    const float difficulty = memory->difficulty;
+++    float next = stability;
+++
+++    if (same_day) {
+++        float growth = expf(FSRS_W[17] * ((float)grade - 3.0f + FSRS_W[18])) *
+++                       powf(stability, -FSRS_W[19]);
+++        if (grade >= 2 && growth < 1.0f) growth = 1.0f;
+++        next = stability * growth;
+++    } else {
+++        const float recall = vocab_fsrs_retrievability(stability, elapsed_days);
+++        if (grade == 1) {
+++            float forgotten = FSRS_W[11] * powf(difficulty, -FSRS_W[12]) *
+++                              (powf(stability + 1.0f, FSRS_W[13]) - 1.0f) *
+++                              expf(FSRS_W[14] * (1.0f - recall));
+++            next = forgotten < stability ? forgotten : stability;
+++        } else {
+++            const float hard_penalty = grade == 2 ? FSRS_W[15] : 1.0f;
+++            const float easy_bonus = grade == 4 ? FSRS_W[16] : 1.0f;
+++            const float growth = expf(FSRS_W[8]) * (11.0f - difficulty) *
+++                                 powf(stability, -FSRS_W[9]) *
+++                                 (expf(FSRS_W[10] * (1.0f - recall)) - 1.0f) *
+++                                 hard_penalty * easy_bonus;
+++            next = stability * (1.0f + growth);
+++        }
+++    }
+++
+++    float delta = -FSRS_W[6] * ((float)grade - 3.0f);
+++    float adjusted = difficulty + delta * (10.0f - difficulty) / 9.0f;
+++    float next_difficulty = FSRS_W[7] * difficulty_anchor_easy() +
+++                            (1.0f - FSRS_W[7]) * adjusted;
+++
+++    memory->stability = clampf(next, FSRS_MIN_STABILITY, FSRS_MAX_STABILITY);
+++    memory->difficulty =
+++        clampf(next_difficulty, FSRS_MIN_DIFFICULTY, FSRS_MAX_DIFFICULTY);
+++}
