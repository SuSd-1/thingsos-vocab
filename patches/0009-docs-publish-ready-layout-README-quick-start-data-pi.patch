++        int used = 0;
++        while (text[i]) {
++            unsigned bytes;
++            const uint32_t cp = vocab_next_cp(text + i, &bytes);
++            const int advance = thingsos_glyph(&app.font, NULL, cp, 0, 0);
++            if (used + advance > max_width) break;
++            used += advance;
++            if (cp == ' ') last_space = i;
++            i += bytes;
