+++static uint32_t crc32_bytes(const void *data, size_t bytes) {
+++    const unsigned char *p = data;
+++    uint32_t crc = 0xFFFFFFFFu;
+++    while (bytes--) {
+++        crc ^= *p++;
+++        for (int bit = 0; bit < 8; bit++)
+++            crc = (crc >> 1) ^ (0xEDB88320u & (uint32_t)(-(int32_t)(crc & 1u)));
+++    }
+++    return ~crc;
