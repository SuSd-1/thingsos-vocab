++++    if (!ensure_dir(path)) return false;
++++    snprintf(path, sizeof(path), "%s/.thingsos/vocab", g_root);
++++    if (!ensure_dir(path)) return false;
++++    snprintf(path, sizeof(path), "%s/.thingsos/vocab/audio", g_root);
