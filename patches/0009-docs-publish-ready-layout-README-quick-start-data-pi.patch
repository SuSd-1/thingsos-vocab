++        g_now = now_min ? now_min : g_now;
++        state_save();
++    }
++    bank_close();
++    free(g_records);
++    free(g_queue);
++    g_records = NULL;
++    g_queue = NULL;
++    g_count = 0;
++    g_queue_len = g_queue_pos = 0;
++    g_undo_count = 0;
++    g_open = false;
++}
