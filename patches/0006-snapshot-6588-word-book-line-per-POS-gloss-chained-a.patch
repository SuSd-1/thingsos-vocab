+static size_t vocab_utf8_width(const char* s) {
+    const unsigned char c = (unsigned char)*s;
+    if (c < 0x80) return 1;
+    if ((c & 0xF8) == 0xF0) return 4;
+    if ((c & 0xF0) == 0xE0) return 3;
+    return 2;
+}
